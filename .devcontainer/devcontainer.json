{
	"name": "Jekyll",
	"image": "mcr.microsoft.com/devcontainers/ruby:3.2-bookworm",

	"features": {
		"ghcr.io/devcontainers/features/node:1": {
			"version": "lts"
		}
	},

	"containerEnv": {
		"LANG": "en_US.UTF-8",
		"LANGUAGE": "en_US:en",
		"LC_ALL": "en_US.UTF-8",
		"TZ": "Etc/UTC"
	},

	"forwardPorts": [
		4000,
		35729
	],

	"postCreateCommand": "gem install bundler jekyll github-pages && sh .devcontainer/post-create.sh",

	"remoteUser": "vscode"
}
